+	(void)x; (void)y;
+	float const ww = l.S(56 * s), hh = l.S(44 * s);
+	float const X0 = l.X(cx) - ww / 2, Y0 = l.Y(cy) - hh / 2;
+	/* back + tab */
+	Poly back; chamfer_poly(back, X0, Y0, ww * 0.42f, hh * 0.3f, hh * 0.12f, hh * 0.12f, 0, 0);
